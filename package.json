{
  "name": "RayyanMFB",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "android:retail:debug": "ENVFILE=.env.retail npx react-native run-android --mode=retailDebug",
    "android:retail:release": "ENVFILE=.env.retail npx react-native run-android --mode=retailRelease",
    "ios:retail:debug": "ENVFILE=.env.retail npx react-native run-ios --scheme RayyanPersonal --mode Debug",
    "ios:retail:release": "ENVFILE=.env.retail npx react-native run-ios --scheme RayyanPersonal --mode Release",
    "build:retail": "yarn android:retail:release && yarn ios:retail:release",
    "start:retail:android": "yarn android:retail:debug",
    "start:retail:ios": "yarn ios:retail:debug",
    "android:retail:apk": "cd android && ./gradlew assembleRetailRelease",
    "android:retail:aab": "cd android && ./gradlew bundleRetailRelease",
    "postinstall": "patch-package",
    "clean:android:build:cache": "cd android && rm -rf app/build app/.cxx build .gradle"
  },
